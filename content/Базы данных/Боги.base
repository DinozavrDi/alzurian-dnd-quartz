formulas:
  Домен бога: prop
properties:
  file.name:
    displayName: Имя божества
views:
  - type: table
    name: Таблица
    filters:
      and:
        - file.folder == "📚 Лор/Боги"
        - file.hasProperty("Домен")
    order:
      - file.name
      - Домен
    sort:
      - property: file.name
        direction: ASC
